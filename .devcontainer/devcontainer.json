{
  "name": "Ares",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "sh .devcontainer/setup.sh",
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "Backend (Express)" },
    "8080": { "label": "Frontend (Vite)" }
  },
  "remoteUser": "node"
}
