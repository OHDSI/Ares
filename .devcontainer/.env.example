# Devcontainer environment - copy to .env and adjust as needed

# PostgreSQL credentials (must match db service)
POSTGRES_PASSWORD=change-me

# Backend
PORT=3000
NODE_ENV=dev
STRATEGUS_SCHEMA=app

# Frontend dev server (0.0.0.0 required for devcontainer port forwarding)
VITE_HOST=0.0.0.0
DATABASE_PATH=/workspace/backend/annotations.duckdb

# PostgreSQL connection (defaults match docker-compose.yml)
POSTGRES_HOST=db
PGPORT=5432
DATABASE_NAME=dev
DATABASE_USERNAME=postgres
