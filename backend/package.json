{
  "name": "ares-backend",
  "version": "0.1",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "start": "tsx ./main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node ./dist/main.js",
    "lint": "eslint src main.ts",
    "lint:fix": "eslint src main.ts --fix"
  },
  "type": "module",
  "imports": {
    "#shared/*": "./dist/src/shared/*",
    "#config/*": "./dist/src/config/*",
    "#utils/*": "./dist/src/utils/*",
    "#types/*": "./dist/src/types/*",
    "#routes/*": "./dist/src/routes/*",
    "#middleware/*": "./dist/src/middleware/*",
    "#controllers/*": "./dist/src/controllers/*"
  },
  "lint-staged": {
    "*.{js,ts}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^25.9.4",
    "@types/pg": "^8.20.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "dependencies": {
    "@databricks/sql": "^1.16.0",
    "@duckdb/node-api": "1.5.2-r.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "pg": "^8.22.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  }
}
