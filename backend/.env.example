# Server
PORT=3000
NODE_ENV=development

# CORS - comma-separated origins; omit to allow all in dev, deny all in prod
# ALLOWED_ORIGINS=http://localhost:8080,https://your-domain.com

# DuckDB (annotations storage)
DATABASE_PATH=./annotations.duckdb

# Strategus schema used when no ?schema= query param is supplied
STRATEGUS_SCHEMA=app

# Multi-tenancy: schema that holds the db_list table of available schemas
# DB_LIST_SCHEMA=db_catalog

# Database provider
# Set DB_PROVIDER=databricks to use Databricks; omit or set to postgres for PostgreSQL
# DB_PROVIDER=postgres

# PostgreSQL (required in production when DB_PROVIDER=postgres)

POSTGRES_HOST=127.0.0.1
PGPORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=
# PGSSL=true


# Databricks (required when DB_PROVIDER=databricks)

# DATABRICKS_HOST=adb-xxxx.azuredatabricks.net
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxx
# DATABRICKS_TOKEN=dapixxxx
# DATABRICKS_CATALOG=
